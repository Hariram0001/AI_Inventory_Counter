# AI Inventory Counter — environment template
# Copy to .env for local use. Never commit real secrets.
# On Streamlit Community Cloud, set the same keys in App → Settings → Secrets.

# Required for live Roboflow inference (leave empty in Demo Mode)
ROBOFLOW_API_KEY=replace_with_your_key

# Optional defaults (models.json remains the registry source of truth)
ROBOFLOW_WORKSPACE=hariram-s-mzhvc
ROBOFLOW_WORKFLOW_ID=custom-workflow

# Use mock detections instead of calling Roboflow (true/false/1/0)
DEMO_MODE=false

# SQLite + runtime artifacts directory
# Local default: ./data
# Streamlit Cloud: ephemeral unless you add durable storage later
DATA_DIR=./data

# --- First administrator bootstrap ---------------------------------------
# Used ONCE, only while the users table is empty, to create the first
# administrator. The account starts with force_password_change set, so the
# password below is replaced at first sign-in. Remove these values afterwards.
# The password must satisfy the policy: at least 12 characters mixing three of
# lowercase, uppercase, digits and symbols, and no placeholder phrases.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_passphrase
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --- Session policy -------------------------------------------------------
# SESSION_IDLE_TIMEOUT_MINUTES=30
# SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# --- OpenRouter (bring your own key) --------------------------------------
# This deployment never stores an OpenRouter key. Each user supplies their own
# on the API Connections page and it lives in their browser session only.
# Set to false to hide OpenRouter models from every user.
# OPENROUTER_MODELS_ENABLED=true
# OPENROUTER_WORKFLOW_ID=playground-gpt-5-6-luna-od
# OPENROUTER_KEY_VERIFY_URL=https://openrouter.ai/api/v1/key

# Optional overrides
# ROBOFLOW_API_URL=https://serverless.roboflow.com
# MAX_UPLOAD_BYTES=26214400
# MAX_INFERENCE_DIMENSION=2048
# MAX_TILES_PER_IMAGE=60
# MAX_API_CALLS_PER_IMAGE=60
# API_CALL_CONFIRM_THRESHOLD=30
# INFERENCE_TIMEOUT_SECONDS=120
