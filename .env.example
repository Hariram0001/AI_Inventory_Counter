# AI Inventory Counter — environment template
# Copy to .env for local use. Never commit real secrets.
# On Streamlit Community Cloud, set the same keys in App → Settings → Secrets.

# Required for live Roboflow inference (leave empty in Demo Mode)
ROBOFLOW_API_KEY=replace_with_your_key

# Optional defaults (models.json remains the registry source of truth)
ROBOFLOW_WORKSPACE=hariram-s-mzhvc
ROBOFLOW_WORKFLOW_ID=custom-workflow

# Use mock detections instead of calling Roboflow (true/false/1/0)
DEMO_MODE=false

# SQLite + runtime artifacts directory
# Local default: ./data
# Streamlit Cloud: ephemeral unless you add durable storage later
DATA_DIR=./data

# Optional overrides
# ROBOFLOW_API_URL=https://serverless.roboflow.com
# MAX_UPLOAD_BYTES=26214400
# MAX_INFERENCE_DIMENSION=2048
# MAX_TILES_PER_IMAGE=60
# MAX_API_CALLS_PER_IMAGE=60
# API_CALL_CONFIRM_THRESHOLD=30
# INFERENCE_TIMEOUT_SECONDS=120
